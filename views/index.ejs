<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <h1>Mini Message Board</h1>

    <a href="/new">Add a new message</a>

    <ul>
      <% messages.forEach((msg, i) => { %>
      <li>
        <strong><%= msg.user %></strong>: <%= msg.text %>
        <br />
        <small><%= msg.added.toLocaleString() %></small>
        <br />
        <a href="/message/<%= i %>">Open</a>
        <!-- OPEN BUTTON -->
      </li>
      <hr />
      <% }) %>
    </ul>
  </body>
</html>
