<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <h1>Add a new message</h1>

    <form method="POST" action="/new">
      <label>Your Name:</label><br />
      <input type="text" name="messageUser" required /><br /><br />

      <label>Message:</label><br />
      <input type="text" name="messageText" required /><br /><br />

      <button type="submit">Submit</button>
    </form>

    <br />
    <a href="/">Back to messages</a>
  </body>
</html>
